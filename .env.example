# Server
PORT=4000
DATABASE_URL=postgres://roadpals:roadpals@localhost:5432/roadpals
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too
# Dev login returns the SMS code in the API response and accepts 000000. Never in production.
DEV_LOGIN=true
# Optional: your own OSRM server for in-app routes, e.g. http://localhost:5000
OSRM_URL=

# Tuning (defaults shown)
NEARBY_RADIUS_M=1500
POSITION_TTL_S=60
MAX_PASSES_PER_PAIR_PER_DAY=6
WAVE_RANGE_M=200
WAVE_LOCK_SPEED_MPS=4
COUPON_HOLD_DAYS=7
POINTS_EXPIRY_DAYS=365

# App (Expo): the phone must reach the server — use your computer's LAN IP, not localhost
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Android builds: Google Maps key for react-native-maps
GOOGLE_MAPS_API_KEY=
